# Local development secrets for `wrangler dev`
# Copy to .dev.vars (gitignored) and fill in real values. NEVER commit .dev.vars.
ENVIRONMENT=dev

# IPInfo (fallback IP intelligence source)
IPINFO_TOKEN=

# IPBot (primary IP intelligence source)
IPBOT_API_ORIGIN=https://api.ipbot.com
IPBOT_API_KEY=

# Turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# AI chat
OPENROUTER_API_KEY=
